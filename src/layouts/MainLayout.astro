---
import { SEO } from 'astro-seo';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import BrandLink from '../components/BrandLink.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  alternates?: Record<string, string>;
  showBrand?: boolean;
  ogImage?: string;
  structuredData?: object;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('heroTagline'),
  alternates = { en: '/', es: '/es/', ca: '/ca/' },
  showBrand = true,
  ogImage = '/og/home.png',
  structuredData,
} = Astro.props;

const brandName = t('brandName');
// Home (no title prop) → "Brand — descriptor"; interior pages → "Page — Brand".
const fullTitle = title
  ? `${title} — ${brandName}`
  : `${brandName} — ${t('brandDescriptor')}`;

const ogLocale = { en: 'en_US', es: 'es_ES', ca: 'ca_ES' }[lang];
const ogImageUrl = new URL(ogImage, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="ZvNGuk8LBsv_di6p7W5bUUBIr1HIIV9zl_9YhEbdafQ"
    />

    <link
      rel="preload"
      href="/fonts/inter/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      Object.entries(alternates).map(([code, path]) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(path, Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates.en, Astro.site)}
    />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: fullTitle,
          type: 'website',
          image: ogImageUrl,
          url: canonical,
        },
        optional: {
          description,
          siteName: brandName,
          locale: ogLocale,
        },
        image: {
          alt: fullTitle,
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: fullTitle,
        description,
        image: ogImageUrl,
        imageAlt: fullTitle,
      }}
    />

    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <header
      class="absolute inset-x-0 top-0 z-10 flex items-center justify-between p-6"
    >
      {showBrand ? <BrandLink /> : <span />}
      <LanguageSwitcher />
    </header>
    <slot />
  </body>
</html>
